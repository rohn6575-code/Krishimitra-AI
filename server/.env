# ──────────────────────────────────────────
#  KrishiMitra AI  –  Environment Variables
# ──────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/krishimitra

# JWT Secret (change this to a long random string in production)
JWT_SECRET=krishimitra_super_secret_key_change_this

# Anthropic Claude API Key  ← PASTE YOUR KEY HERE
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenWeatherMap API (free at openweathermap.org)
WEATHER_API_KEY=your_openweathermap_key_here

# Python ML Service URL (when you run the Flask service)
ML_SERVICE_URL=http://localhost:5001

# Frontend URL (for CORS)
FRONTEND_URL=http://127.0.0.1:5500
